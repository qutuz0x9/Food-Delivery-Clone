{
  "name": "food-delivery-clone",
  "version": "1.0.0",
  "description": "Food Delivery Clone Project to simulate real world food delivery applications like (Talabat, UberEat)",
  "keywords": [
    "nodejs",
    "expressjs",
    "typescript",
    "prisma",
    "postgresql",
    "docker",
    "git",
    "github",
    "github-actions",
    "openapi"
  ],
  "homepage": "https://github.com/qutuz0x9/Food-Delivery-Clone#readme",
  "bugs": {
    "url": "https://github.com/qutuz0x9/Food-Delivery-Clone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qutuz0x9/Food-Delivery-Clone.git"
  },
  "author": "qutuz0x9",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose -f compose.test.yaml up -d --wait",
    "test:db:migrate": "DOTENV_CONFIG_PATH=.env.test npm run -s db:migrate",
    "test:db": "DOTENV_CONFIG_PATH=.env.test vitest run --config vitest.db.config.ts",
    "test:db:down": "docker compose -f compose.test.yaml down",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:api": "redocly lint docs/api/openapi.yaml",
    "bundle:api": "redocly bundle docs/api/openapi.yaml -o dist/openapi.bundled.yaml",
    "prebuild": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "contract:infer": "prisma contract infer",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:migrate:show": "prisma db migrate --show",
    "db:seed": "tsx src/scripts/seed.ts",
    "postman:cases": "tsx src/scripts/spec-to-postman.ts",
    "db:verify": "prisma db verify",
    "db:schema": "prisma db schema",
    "migration:plan": "prisma migration plan --name",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "migration:log": "prisma migration log",
    "docker:dev": "docker compose --env-file .env.dev -f compose.yaml -f compose.dev.yaml",
    "docker:dev:up": "npm run -s docker:dev -- up -d --build",
    "docker:dev:down": "npm run -s docker:dev -- down",
    "docker:dev:start": "npm run -s docker:dev -- start",
    "docker:dev:stop": "npm run -s docker:dev -- stop",
    "docker:dev:restart": "npm run -s docker:dev -- restart api",
    "docker:dev:build": "npm run -s docker:dev -- build",
    "docker:dev:ps": "npm run -s docker:dev -- ps -a",
    "docker:dev:logs": "npm run -s docker:dev -- logs -f --tail 100",
    "docker:dev:logs:api": "npm run -s docker:dev -- logs -f --tail 100 api",
    "docker:dev:logs:db": "npm run -s docker:dev -- logs -f --tail 100 db",
    "docker:dev:logs:migrate": "npm run -s docker:dev -- logs -f --tail 100 migrate",
    "docker:dev:logs:pgadmin": "npm run -s docker:dev -- logs -f --tail 100 pgadmin",
    "docker:dev:migrate": "npm run -s docker:dev -- run --rm --build migrate",
    "docker:dev:seed": "npm run -s docker:dev -- run --rm --build migrate npm run db:seed",
    "docker:dev:shell": "npm run -s docker:dev -- exec api sh",
    "docker:dev:psql": "npm run -s docker:dev -- exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "docker:dev:reset": "npm run -s docker:dev -- down -v",
    "docker:staging": "docker compose --env-file .env.staging -f compose.yaml -f compose.stage.yaml",
    "docker:staging:up": "npm run -s docker:staging -- up -d --build",
    "docker:staging:down": "npm run -s docker:staging -- down",
    "docker:staging:start": "npm run -s docker:staging -- start",
    "docker:staging:stop": "npm run -s docker:staging -- stop",
    "docker:staging:restart": "npm run -s docker:staging -- restart api",
    "docker:staging:build": "npm run -s docker:staging -- build",
    "docker:staging:ps": "npm run -s docker:staging -- ps -a",
    "docker:staging:logs": "npm run -s docker:staging -- logs -f --tail 100",
    "docker:staging:logs:api": "npm run -s docker:staging -- logs -f --tail 100 api",
    "docker:staging:logs:db": "npm run -s docker:staging -- logs -f --tail 100 db",
    "docker:staging:logs:migrate": "npm run -s docker:staging -- logs -f --tail 100 migrate",
    "docker:staging:migrate": "npm run -s docker:staging -- run --rm --build migrate",
    "docker:staging:seed": "npm run -s docker:staging -- run --rm --build migrate npm run db:seed",
    "docker:staging:shell": "npm run -s docker:staging -- exec api sh",
    "docker:staging:psql": "npm run -s docker:staging -- exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "docker:staging:reset": "npm run -s docker:staging -- down -v",
    "docker:prod": "docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml",
    "docker:prod:up": "npm run -s docker:prod -- up -d --build",
    "docker:prod:down": "npm run -s docker:prod -- down",
    "docker:prod:start": "npm run -s docker:prod -- start",
    "docker:prod:stop": "npm run -s docker:prod -- stop",
    "docker:prod:restart": "npm run -s docker:prod -- restart api",
    "docker:prod:build": "npm run -s docker:prod -- build",
    "docker:prod:ps": "npm run -s docker:prod -- ps -a",
    "docker:prod:logs": "npm run -s docker:prod -- logs -f --tail 100",
    "docker:prod:logs:api": "npm run -s docker:prod -- logs -f --tail 100 api",
    "docker:prod:logs:db": "npm run -s docker:prod -- logs -f --tail 100 db",
    "docker:prod:logs:migrate": "npm run -s docker:prod -- logs -f --tail 100 migrate",
    "docker:prod:migrate": "npm run -s docker:prod -- run --rm --build migrate",
    "docker:prod:shell": "npm run -s docker:prod -- exec api sh",
    "docker:prod:psql": "npm run -s docker:prod -- exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.4.0",
    "@redocly/cli": "^2.57.0",
    "@stoplight/prism-cli": "^5.15.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.11.0",
    "express-rate-limit": "^8.7.1",
    "markdownlint-cli2": "^0.23.3",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prisma": "^8.0.0-rc.15",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
