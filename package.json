{
  "name": "food-delivery-clone",
  "version": "1.0.0",
  "description": "Food Delivery Clone Project to simulate real world food delivery applications like (Talabat, UberEat)",
  "keywords": [
    "nodejs",
    "expressjs",
    "typescript",
    "prisma",
    "postgresql",
    "docker",
    "git",
    "github",
    "github-actions",
    "openapi"
  ],
  "homepage": "https://github.com/qutuz0x9/Food-Delivery-Clone#readme",
  "bugs": {
    "url": "https://github.com/qutuz0x9/Food-Delivery-Clone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qutuz0x9/Food-Delivery-Clone.git"
  },
  "author": "qutuz0x9",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prebuild": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "contract:infer": "prisma contract infer",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:migrate:show": "prisma db migrate --show",
    "db:verify": "prisma db verify",
    "db:schema": "prisma db schema",
    "migration:plan": "prisma migration plan --name",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "migration:log": "prisma migration log"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.11.0",
    "markdownlint-cli2": "^0.23.3",
    "nodemon": "^3.1.14",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prisma": "^8.0.0-rc.15",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  }
}
