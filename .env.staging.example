# Copy to .env.staging. Used with: npm run docker:staging:up
# Staging mirrors prod: same image, production mode, different database and secrets.
APP_ENV=staging
NODE_ENV=production
API_HOST_PORT=3001
POSTGRES_USER=food
POSTGRES_PASSWORD=change-me
POSTGRES_DB=food_staging

# Secret that signs JWT access tokens: at least 32 random characters, different in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
