# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=1000

# GitHub Personal Access Token used by the `github` MCP server in .mcp.json.
GITHUB_PAT="your-github-pat-here"
# Secret that signs JWT access tokens: at least 32 random characters, different in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
