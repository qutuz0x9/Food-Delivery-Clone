# Copy to .env.dev. Used with: npm run docker:dev:up
APP_ENV=dev
NODE_ENV=development
API_HOST_PORT=3000
DB_HOST_PORT=5433
POSTGRES_USER=food
POSTGRES_PASSWORD=food_dev_password
POSTGRES_DB=food_dev
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin_dev_password

# Secret that signs JWT access tokens: at least 32 random characters, different in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
